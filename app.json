{
  "expo": {
    "name": "Tripfold",
    "slug": "tabi-shiori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fukuda.tripfold",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Tripfold uses your photo library to pick booking screenshots and trip photos.",
        "NSLocationWhenInUseUsageDescription": "Tripfold uses your location to show where you are on the trip map.",
        "NSCameraUsageDescription": "Tripfold uses the camera to scan receipts and boarding passes.",
        "NSSupportsLiveActivities": true,
        "NSFaceIDUsageDescription": "Tripfold uses Face ID to open your important documents (such as passport copies)."
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13141B"
    },
    "backgroundColor": "#F4F3EF",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Tripfold uses your photo library to pick booking screenshots and trip photos.",
          "cameraPermission": "Tripfold uses the camera to scan receipts and boarding passes."
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1,
            "NSExtensionActivationSupportsFileWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tripfold uses your location to show where you are on the trip map."
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "NextTrip",
              "displayName": "Tripfold",
              "description": "Next booking, countdown and booking ref",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "accessoryRectangular"
                ],
                "initialLayout": "./src/widgets/NextWidget.tsx"
              }
            }
          ]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tripfold uses Face ID to open your important documents (such as passport copies)."
        }
      ]
    ],
    "owner": "chihayax",
    "extra": {
      "eas": {
        "projectId": "51d9cc15-7dc4-4e72-9e57-3693dd68a114"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/51d9cc15-7dc4-4e72-9e57-3693dd68a114"
    },
    "scheme": "tripfold",
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json",
      "ko": "./locales/ko.json",
      "zh-Hans": "./locales/zh-Hans.json",
      "zh-Hant": "./locales/zh-Hant.json",
      "es": "./locales/es.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "it": "./locales/it.json",
      "pt": "./locales/pt.json"
    }
  }
}