{
  "expo": {
    "name": "Tripfold",
    "slug": "tabi-shiori",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fukuda.tripfold",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "ja",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "予約のスクショや旅行の写真を選ぶために写真ライブラリを使います。"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13141B"
    },
    "backgroundColor": "#F4F3EF",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "予約のスクショや旅行の写真を選ぶために写真ライブラリを使います。"
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "androidIntentFilters": [
            "text/*",
            "image/*"
          ]
        }
      ]
    ],
    "owner": "chihayax",
    "extra": {
      "eas": {
        "projectId": "51d9cc15-7dc4-4e72-9e57-3693dd68a114"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/51d9cc15-7dc4-4e72-9e57-3693dd68a114"
    },
    "scheme": "tripfold"
  }
}
