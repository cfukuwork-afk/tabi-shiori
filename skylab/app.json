{
  "expo": {
    "name": "SkyLab",
    "slug": "skylab-sky",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "skylab",
    "owner": "chihayax",
    "backgroundColor": "#0B1026",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1026"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fukuda.skylab",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Your location is used to forecast what you can see in the sky from where you are."
      }
    },
    "locales": {
      "ja": "./locales/ja.json",
      "en": "./locales/en.json"
    },
    "plugins": [
      "expo-notifications",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used to forecast what you can see in the sky from where you are."
        }
      ]
    ]
  }
}